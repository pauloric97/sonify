# ------------------------------------------------------------------
# Sonify — copie para .env e preencha
# ------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# Segredo dos tokens de login. Gere um: openssl rand -hex 32
JWT_SECRET=troque-isto-por-uma-string-aleatoria-longa

# Onde ficam o banco SQLite e os thumbnails
DATA_DIR=./data

# ------------------------------------------------------------------
# Storage S3-compatível (Cloudflare R2 OU Backblaze B2)
# ------------------------------------------------------------------
# --- Cloudflare R2 ---
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_REGION=auto
#
# --- Backblaze B2 ---
# S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# S3_REGION=us-west-004

S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=sonify
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# B2 costuma precisar de path style; R2 funciona com false
S3_FORCE_PATH_STYLE=false

# Validade (em segundos) das URLs assinadas de streaming
SIGNED_URL_TTL=21600

# Prefixo opcional dentro do bucket (ex: midia/)
S3_PREFIX=

# ------------------------------------------------------------------
# Capa e metadados de fontes externas
# ------------------------------------------------------------------
# Música (iTunes + Deezer) não precisa de chave nenhuma, já funciona.
# Vídeo usa o TMDB: crie uma chave grátis em
#   https://www.themoviedb.org/settings/api  (API Key v3, a curtinha)
TMDB_API_KEY=

# Busca automaticamente no upload/scan quando o arquivo não tem tag ou capa.
# Nunca sobrescreve o que já veio no arquivo. Coloque false pra desligar.
ENRICH_ON_INGEST=true

# ------------------------------------------------------------------
# qBittorrent (opcional)
# ------------------------------------------------------------------
# Ligue a Web UI no qBittorrent: Ferramentas → Opções → Web UI
# Deixe em branco pra desativar a integração.
QBIT_URL=http://localhost:8080
QBIT_USER=admin
QBIT_PASS=

# Só torrents dessa categoria são gerenciados pelo Sonify. O resto fica intocado.
QBIT_CATEGORY=sonify
# Onde o qBittorrent salva (em branco = usa o padrão dele)
QBIT_SAVE_PATH=

# Ao concluir: sobe pro bucket, cadastra na biblioteca e remove o torrent + arquivos
QBIT_AUTO_IMPORT=true
QBIT_DELETE_AFTER=true
QBIT_POLL_SECONDS=30
# Ignora arquivo menor que isso (sample, thumbnail, sobra)
QBIT_MIN_FILE_BYTES=300000

# País usado no RSS da Apple no Explorar (br, us, pt…)
CATALOGO_PAIS=br
